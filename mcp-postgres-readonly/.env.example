# Copy to .env (never commit it). Log in as the read-only role, never as an admin or app owner.
DATABASE_URL=postgresql://mcp_reader:CHANGE_ME@localhost:5432/shop
# Comma-separated schemas the server lists and searches. Grants decide what is actually readable.
ALLOWED_SCHEMAS=public
STATEMENT_TIMEOUT_MS=5000

# Only for test_server.py, against a THROWAWAY database (it drops and recreates sample tables).
ADMIN_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/shop
